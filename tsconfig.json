{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // 先用寬鬆模式讓舊程式碼編譯通過，之後再一個一個打開
    "strict": false
  },
  "include": ["src"]
}
